# Send only build inputs. Local genomes, credentials, caches and Git history stay out.
**
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.ts
!eslint.config.ts
!src/**
!scripts/**
!tests/**
!public/favicon.svg
!public/robots.txt
!public/icons/**
!public/demos/**
!public/ref/**
!public/samples/README.md
!public/samples/HG002_GRCh38.vcf.gz

# Ignore local junk even if it sits inside an included source directory.
**/node_modules
**/.DS_Store
**/._*
